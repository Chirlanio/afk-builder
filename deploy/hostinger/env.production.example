# .env de produção do afk-builder na Hostinger.
# Vai em ~/domains/nexa.app.br/public_html/afk-builder/.env — nunca no Git.
# Preencha o que está marcado com <>.

APP_NAME="AFK Builder"
APP_ENV=production
APP_KEY=<base64:... — gere com `php artisan key:generate --show`>
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://nexa.app.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL roda no mesmo servidor: conectar em 127.0.0.1, nunca no host srvNNNN.hstgr.io.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<u401878354_afk>
DB_USERNAME=<u401878354_afk>
DB_PASSWORD=<senha>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Só depois que o SSL estiver ativo — com true em HTTP puro o login entra em loop.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fila em banco, consumida pelo cron `cron.sh queue` (ver README).
QUEUE_CONNECTION=database
# Tem que ser maior que o timeout do RunArtisanCommandJob (1800s): com o padrão
# de 90s, um job do /admin/sync que passe disso é liberado para outro worker e
# marcado como falho enquanto ainda roda.
DB_QUEUE_RETRY_AFTER=1900
CACHE_STORE=database
CACHE_PREFIX=

# E-mail da Hostinger (caixa no-reply@nexa.app.br). O domínio precisa de MX, SPF,
# DKIM e DMARC publicados no Registro.br — ver deploy/hostinger/README.md.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@nexa.app.br
MAIL_PASSWORD=<senha da caixa>
MAIL_FROM_ADDRESS="no-reply@nexa.app.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
