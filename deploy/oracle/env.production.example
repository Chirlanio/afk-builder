# .env de producao do afk-builder na VM Oracle.
# Copie para /var/www/afk-builder/.env e preencha o que esta marcado com <>.
#
#   sudo -u afk cp deploy/oracle/env.production.example .env
#   sudo -u afk php artisan key:generate

APP_NAME="AFK Builder"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://<seu-dominio>

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` em vez de `single`: o single deixa laravel.log crescer sem limite e o
# boot volume do Always Free e pequeno.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Senha gerada pelo provision.sh — esta em /root/afk-builder-credentials.txt
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afk_builder
DB_USERNAME=afk_builder
DB_PASSWORD=<senha-do-arquivo-de-credenciais>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Ativar SOMENTE depois que o certbot estiver rodando — com true no HTTP puro
# o cookie de sessao nunca e enviado e o login entra em loop.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

# Disco local funciona aqui (ao contrario do serverless): o storage:link do
# deploy.sh aponta public/storage -> storage/app/public e o nginx serve.
FILESYSTEM_DISK=local

# Fila em banco, consumida pelo worker do supervisor (2 processos).
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="afk-builder@<seu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
